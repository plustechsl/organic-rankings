# ============================================================================
# Organic Rankings — variables de entorno
#
# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
#
# La red interna no se toca: postgres, redis y api no publican puertos,
# el frontend habla con ellos por el nombre del servicio en la red de compose.
# El ÚNICO puerto publicado es FRONTEND_PORT.
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=organic_rankings
POSTGRES_USER=organic_rankings
# Obligatorio. Genera una contraseña fuerte y guárdala en tu gestor de claves.
POSTGRES_PASSWORD=

# --- API --------------------------------------------------------------------
# "production" en el servidor, "development" en local.
APP_ENV=production

# Obligatorio en producción (si es el valor por defecto, la API no arranca).
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Obligatorio en producción. Genera otro distinto al de JWT_SECRET:
# python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=

ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Cloudflare Turnstile (obligatorio en producción con APP_ENV=production).
# Clave PRIVADA del sitio; la pública va en NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Redis) --------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Frontend ---------------------------------------------------------------
# Puerto publicado en el host (el único de todo el stack):
FRONTEND_PORT=3000

# Site key PÚBLICA de Cloudflare Turnstile (vacío = registro/login sin captcha):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# URL de la pasarela de donaciones (vacío = no se muestra el botón de donar):
NEXT_PUBLIC_DONATE_URL=
